<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device in a cloud backup or a device-to-device transfer. The app holds
     device keys, and a device whose data is restored or copied would sign versions that clash
     with the original's (ADR 0024); a new device pairs instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
